# eat – Produktionswerte. Vorlage ohne echte Werte, nie echte Werte hier eintragen.
#
# Komodo (Standard): Werte stehen im Stack unter „Environment“ (deploy/komodo/eat.toml). Mit [SECRET] markierte
# Werte als Komodo-Variable mit Häkchen „Secret“ anlegen (Settings → Variables, Name hinter „Komodo:“) – im
# Environment stehen sie als Platzhalter mit doppelten eckigen Klammern. Komodo schreibt .env.prod.local bei jedem
# Deploy neu; die Datei auf dem Server also nicht von Hand ändern.
# Von Hand / Probelauf: diese Datei nach .env.prod.local kopieren, ausfüllen, dann
#   docker compose -p eat -f compose.prod.yaml --env-file .env.prod.local up -d --build --wait
# .env.prod.local nie ins Repository.
#
# „von securitas“ = Wert aus /var/www/fifa_tournament/.env (bzw. .env.local) auf dem alten Server übernehmen.

# --- Adresse ---------------------------------------------------------------------------------------------
# Öffentliche Adresse mit https://. Komodo: fest in eat.toml.
DEFAULT_URI=https://eat.example.de

# --- Secrets ---------------------------------------------------------------------------------------------
# [SECRET] Symfony-Schlüssel (Sitzungen, Remember-me, CSRF). Von securitas (APP_SECRET) übernehmen; sonst neu:
# `openssl rand -hex 32` (alle müssen sich dann einmal neu anmelden). Komodo: EAT_APP_SECRET
APP_SECRET=
# [SECRET] Passwort des Datenbank-Benutzers „eat“ in MySQL 8.4 (neu, nicht das von securitas: die DB wird per
# Dump übernommen). Neu würfeln: `openssl rand -hex 24`. Gilt nur beim allerersten Start; danach muss es zum
# Volume passen. Komodo: EAT_MYSQL_PASSWORD
MYSQL_PASSWORD=
# [SECRET] Root-Passwort der Datenbank (auch für Sicherungen und Import). Neu würfeln wie oben.
# Komodo: EAT_MYSQL_ROOT_PASSWORD
MYSQL_ROOT_PASSWORD=
# [SECRET] Spotify-App (developer.spotify.com → Dashboard → App). Von securitas (SPOTIFY_CLIENT_ID /
# SPOTIFY_CLIENT_SECRET). Komodo: EAT_SPOTIFY_CLIENT_ID, EAT_SPOTIFY_CLIENT_SECRET
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# [SECRET] Signatur der Bild-URLs (/img/… → imgproxy). Neu würfeln, je `openssl rand -hex 32`. Lassen sich jederzeit
# ändern (dann gelten nur die alten Bild-URLs im Browser-Cache nicht mehr). Komodo: EAT_IMGPROXY_KEY, EAT_IMGPROXY_SALT
IMGPROXY_KEY=
IMGPROXY_SALT=
# [SECRET] Optional: Fehlermeldungen an Sentry. Von securitas (SENTRY_DSN), leer = aus. Komodo: EAT_SENTRY_DSN
# (ohne Sentry die Zeile im Komodo-Environment löschen statt eine leere Variable anzulegen)
SENTRY_DSN=

# --- Spotify ---------------------------------------------------------------------------------------------
# Muss im Spotify-Developer-Dashboard unter „Redirect URIs“ eingetragen sein. Komodo: fest in eat.toml.
SPOTIFY_REDIRECT_URI=https://eat.example.de/spotify/callback
# Länge der Tor-Hymne in Sekunden (securitas: FORCED_RUNNING_TIME)
FORCED_RUNNING_TIME=30

# --- Verhalten -------------------------------------------------------------------------------------------
# Offene Registrierung unter /register: 0 = aus (Produktion). Benutzer per app:create-default-user anlegen.
REGISTRATION_ENABLED=0
# Keine Mails (eat verschickt nichts, seit die Registrierung aus ist).
MAILER_DSN=null://null

# --- Datenbank (fest, nicht ändern: gehört zum Volume) ----------------------------------------------------
MYSQL_DATABASE=eat
MYSQL_USER=eat

# --- Eingang: Caddy auf dem VPS → WireGuard → hierher -----------------------------------------------------
# Einziger Host-Port des Stacks (abyss: 8199) und die Adresse, auf der er lauscht (WireGuard-IP von abyss).
HTTP_PORT=8199
HTTP_BIND=10.0.0.2
# Von wem X-Forwarded-For/-Proto übernommen werden: die WireGuard-IP des VPS-Caddys.
REVERSE_PROXY_IPS=10.0.0.1

# --- Host-Ordner (einmalig anlegen, docs/deployment.md) ----------------------------------------------------
# Originalbilder (Uploads, Team-Wappen); gehört UID/GID 82 (www-data im Image). app schreibt, imgproxy liest (nur lesend).
# Offsite über das homelab-Inventar.
IMAGE_HOST_DIR=/srv/eat/images
# Datenbank-Dumps; Docker legt den Ordner absichtlich nicht selbst an.
BACKUP_DIR=/srv/eat/backups
# So viele Dumps je Anlass (daily, pre-deploy, manuell) bleiben liegen; täglich 14 = zwei Wochen.
BACKUP_KEEP=14

# --- Nur für Probeläufe ----------------------------------------------------------------------------------
# Präfix der Volume-Namen (Standard eat → eat_database_data usw.). Auf dem Server NIE setzen. Für Probeläufe
# PFLICHT, zusammen mit einem eigenen Projektnamen (-p eatprobe).
#VOLUME_PREFIX=eatprobe
