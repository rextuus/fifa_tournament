{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Registrieren{% endblock %}
{% block body_class %}auth-page{% endblock %}
{% block header %}{% endblock %}

{% block body %}
    <div class="auth-card">
        <div class="auth-logo">{{ icons.icon('trophy', 32) }}</div>
        <h1>Registrieren</h1>
        <p class="auth-sub">Neues Konto für den Turniermanager.</p>

        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}

        {{ form_errors(registrationForm) }}

        <div class="panel">
            {{ form_start(registrationForm) }}
            {{ form_row(registrationForm.email, { label: 'E-Mail' }) }}
            {{ form_row(registrationForm.plainPassword, { label: 'Passwort' }) }}
            {{ form_row(registrationForm.agreeTerms) }}
            <button type="submit" class="btn btn-primary btn-lg btn-block mt-2">Konto anlegen</button>
            {{ form_end(registrationForm) }}
        </div>

        <p class="text-center text-muted mt-3">
            Schon registriert? <a href="{{ path('app_login') }}">Einloggen</a>
        </p>
    </div>
{% endblock %}
