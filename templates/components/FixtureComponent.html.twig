{% set isPlayed = fixture.played is not null %}
{% set sides = [
    {team: fixture.homeTeam, participant: fixture.homeParticipant},
    {team: fixture.awayTeam, participant: fixture.awayParticipant},
] %}
<div{{ attributes }}>
    <a href="{{ path('match_detail', { id: fixture.id }) }}"
       class="match-card {{ isPlayed ? 'is-played' }} {{ highlight ? 'is-next' }}">
        <div class="match-top">
            <span class="match-ident">{{ fixture.ident }}</span>
            {% if isPlayed %}
                <span class="chip is-finished no-dot">Gespielt</span>
            {% elseif highlight %}
                <span class="chip is-live">Als Nächstes</span>
            {% else %}
                <span class="chip no-dot">Offen</span>
            {% endif %}
        </div>
        <div class="match-body">
            {% for side in sides %}
                {% if loop.index == 2 %}
                    {% if isPlayed and fixture.firstLeg %}
                        <div class="score">{{ fixture.firstLeg.homeGoals }}:{{ fixture.firstLeg.awayGoals }}</div>
                    {% elseif fixture.homeGoals > 0 or fixture.awayGoals > 0 %}
                        <div class="score">{{ fixture.homeGoals }}:{{ fixture.awayGoals }}</div>
                    {% else %}
                        <div class="score is-vs">VS</div>
                    {% endif %}
                {% endif %}
                <div class="side">
                    <div class="crest-wrap">
                        <span class="avatar is-crest md">
                            <img src="{{ side.team is not null and side.team.imageFile ? image_url(side.team.imageFile, 'x-large') : asset('images/thumbnails/team_default.png') }}"
                                 alt="" loading="lazy">
                        </span>
                        {% if side.participant %}
                            <span class="avatar owner">
                                <img src="{{ side.participant.imageFile ? image_url(side.participant.imageFile, 'x-large') : asset('images/thumbnails/client_default.png') }}"
                                     alt="" loading="lazy">
                            </span>
                        {% endif %}
                    </div>
                    <div class="side-team">{{ side.team.name ?? 'TBA' }}</div>
                    <div class="side-player">{{ side.participant.ident ?? '–' }}</div>
                </div>
            {% endfor %}
        </div>
    </a>
</div>
