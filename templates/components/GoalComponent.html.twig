{% set locked = fixture.played is not null %}
<div class="panel goal-pad"
     data-controller="goal"
     data-goal-fixture-id="{{ fixture.id }}"
     data-goal-participant-id="{{ participant.id }}"
     data-goal-is-home="{{ isHome ? '1' : '0' }}">
    <div class="goal-pad-head">
        <h3>{{ participant.ident }}</h3>
        <span class="goal-count" data-goal-target="goalValue">{{ this.goalValue }}</span>
    </div>
    <div class="goal-buttons">
        {% for player in participant.players %}
            <button type="button" class="goal-btn"
                    data-action="goal#increaseGoal"
                    data-player-id="{{ player.id }}"
                    {{ locked ? 'disabled' }}>
                {{ component('ProfileImageComponent', {profile: player, width: 40}) }}
                <span class="goal-name">{{ player.ident }}</span>
                <span class="goal-plus">+ TOR</span>
            </button>
        {% endfor %}
    </div>
</div>
