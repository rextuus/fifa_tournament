<div{{ attributes }}>
    {% set track = this.track %}
    {% if this.isTrackFilled() %}
        <div class="track">
            <img src="{{ track.coverUrl }}" alt="" class="track-cover">
            <div class="track-body">
                <div class="track-name">{{ track.trackName }}</div>
                <div class="track-artist">{{ track.artistName }} · {{ track.albumName }}</div>
                <div class="track-range">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    {{ duration_in_minutes(this.entity.goalHymnStartTime) }} – {{ duration_in_minutes(this.entity.goalHymnEndTime) }}
                </div>
            </div>
        </div>
    {% else %}
        <div class="track is-empty">Noch keine Torhymne ausgewählt</div>
    {% endif %}
</div>
