{% set isCrest = this.profile.defaultImageType.name == 'TEAM_PROFILE' %}
<span{{ attributes.defaults({class: 'avatar' ~ (isCrest ? ' is-crest' : ''), style: '--size: ' ~ this.width ~ 'px'}) }}>
    <img src="{{ this.profile.imageFile ? image_url(this.profile.imageFile, 'x-large') : asset(this.getDefaultImage()) }}"
         alt="" loading="lazy">
</span>
