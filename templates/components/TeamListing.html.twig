<div{{ attributes.defaults({class: 'team-grid'}) }}>
    {% for team in this.teams %}
        <div class="team-card">
            <span class="avatar is-crest lg">
                <img src="{{ team.imageFile ? image_url(team.imageFile, 'x-large') : asset('images/thumbnails/team_default.png') }}"
                     alt="" loading="lazy">
            </span>
            <div class="team-card-name">{{ team }}</div>
            <form method="post" action="{{ path('tournament_team_remove', {
                'teamListId': this.getTeamListId,
                'teamId': team.id
            }) }}">
                <button type="submit" class="btn btn-danger btn-sm btn-icon" title="Team entfernen" aria-label="Team entfernen">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </form>
        </div>
    {% endfor %}
</div>
