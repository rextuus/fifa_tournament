{% import '_icons.html.twig' as icons %}
<div{{ attributes.defaults({class: 'stack'}) }}>
    <div class="profile-head">
        {{ component('ProfileImageComponent', {profile: this.entity, width: 112}) }}
        <div>
            <div class="eyebrow">{{ icons.icon('music', 14) }} Torhymne für</div>
            <h1>{{ this.entity.ident }}</h1>
        </div>
    </div>

    {{ component('TrackComponent', {participant: participant, player: player, track: this.track}) }}

    <div class="d-flex gap-2 flex-wrap">
        {% if this.track.spotifyId != '' %}
            <a href="{{ path('app_select_song', { id: this.entity.id, spotifyTrack: this.track.spotifyId, type: this.typeForEntity }) }}"
               class="btn btn-secondary flex-fill">{{ icons.icon('clock', 18) }} Ausschnitt</a>
            <a href="{{ this.testRoute }}" class="btn btn-secondary flex-fill"
               title="Unterbricht den laufenden Stream des verknüpften Spotify-Kontos ({{ this.spotifyName }})">
                {{ icons.icon('play', 18) }} Anhören
            </a>
        {% endif %}
        <button type="button" class="btn btn-secondary flex-fill"
                data-action="live#action"
                data-live-action-param="debounce(500)|createQrCode">
            {{ icons.icon('qr', 18) }} QR-Code
        </button>
    </div>

    {% if this.track.spotifyId != '' %}
        <p class="text-muted small mb-0">
            „Anhören“ unterbricht den laufenden Stream des verknüpften Spotify-Kontos
            (momentan: <strong class="text-white">{{ this.spotifyName }}</strong>).
        </p>
    {% endif %}

    {% set qrCode = this.qrCode %}
    {% if qrCode is not null %}
        <div class="qr-box">
            <img src="{{ qrCode }}" alt="QR-Code">
            <p><strong>Am Handy weitermachen</strong>QR-Code scannen, um die Torhymne direkt auf dem Smartphone auszuwählen.</p>
        </div>
    {% endif %}
</div>
