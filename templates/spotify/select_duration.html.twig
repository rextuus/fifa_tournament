{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Ausschnitt wählen{% endblock %}

{% block body %}
    <div class="narrow" data-controller="select-song-duration">
        <div class="page-head">
            <div>
                <div class="eyebrow">{{ icons.icon('clock', 14) }} Torhymne</div>
                <h1 class="page-title">Ausschnitt wählen</h1>
            </div>
        </div>

        <div class="stack-lg">
            {{ component('TrackComponent', {participant: participant, player: player, track: track}) }}

            <div class="kv">
                <div><span>Song (s)</span><strong data-select-song-duration-target="maximum">{{ trackDuration }}</strong></div>
                <div><span>Max. (s)</span><strong data-select-song-duration-target="range">{{ playTimeLimit }}</strong></div>
                <div class="is-accent"><span>Aktuell (s)</span><strong data-select-song-duration-target="currentLabel">30</strong></div>
            </div>

            <div class="panel">
                {{ form_start(form) }}
                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="form-label mb-0">Start</span>
                        <strong data-select-song-duration-target="startLabel">0:00</strong>
                    </div>
                    {{ form_widget(form.start, {
                        attr: {
                            'class': 'form-range',
                            'data-select-song-duration-target': 'start',
                            'data-action': 'input->select-song-duration#adjust'
                        }
                    }) }}
                </div>

                <div class="mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="form-label mb-0">Ende</span>
                        <strong data-select-song-duration-target="endLabel">1:00</strong>
                    </div>
                    {{ form_widget(form.end, {
                        attr: {
                            'class': 'form-range',
                            'data-select-song-duration-target': 'end',
                            'data-action': 'input->select-song-duration#adjust'
                        }
                    }) }}
                </div>

                {{ form_widget(form.save, { attr: { 'class': 'btn btn-primary btn-lg btn-block' } }) }}
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
