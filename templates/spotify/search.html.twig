{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Torhymne{% endblock %}

{% block body %}
    <div class="narrow stack-lg">
        {{ component('ParticipantComponent', {participant: participant, player: player, size: 300}) }}

        <section class="panel">
            {% if spotifyIsAvailable %}
                <div class="panel-head"><h2>Song suchen</h2></div>
                {{ form_start(form) }}
                <div class="d-flex gap-2">
                    {{ form_widget(form.q, { 'attr': { 'class': 'form-control', 'placeholder': 'Titel oder Interpret…' } }) }}
                    {{ form_widget(form.search, { 'attr': { 'class': 'btn btn-primary', 'style': 'flex-shrink: 0' } }) }}
                </div>
                {{ form_end(form) }}
            {% else %}
                <div class="empty py-3">
                    {{ icons.icon('spotify', 40) }}
                    <p>Bitte zuerst bei Spotify anmelden.</p>
                    <a href="{{ path('spotify_login') }}" class="btn btn-primary">{{ icons.icon('login', 18) }} Zum Spotify-Login</a>
                </div>
            {% endif %}
        </section>

        {% if tracks is not empty %}
            <section>
                <h2 class="section-title">Treffer <span class="count">{{ tracks|length }}</span></h2>
                <div class="tile-list">
                    {% for track in tracks %}
                        <a href="{{ path('app_select_song', { id: targetEntity.id, spotifyTrack: track.spotifyId, type: type }) }}"
                           data-turbo="false" class="track is-link">
                            <img src="{{ track.coverUrl }}" alt="" class="track-cover" loading="lazy">
                            <div class="track-body">
                                <div class="track-name">{{ track.trackName }}</div>
                                <div class="track-artist">{{ track.artistName }}</div>
                            </div>
                            <span class="tile-chevron">{{ icons.icon('chevron', 20) }}</span>
                        </a>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </div>
{% endblock %}
