{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Neue Truppe{% endblock %}

{% block body %}
    <div class="narrow">
        <a href="{{ path('participant_manage') }}" class="back-link">{{ icons.icon('back', 18) }} Truppen</a>
        <div class="page-head">
            <div>
                <div class="eyebrow">{{ icons.icon('plus', 14) }} Anlegen</div>
                <h1 class="page-title">Neue Truppe</h1>
            </div>
        </div>

        <div class="panel">
            {{ form_start(form) }}
            {{ form_row(form.ident) }}
            {{ form_row(form.players) }}
            {{ form_rest(form) }}
            <button type="submit" class="btn btn-primary btn-lg btn-block mt-2">{{ icons.icon('check', 20) }} Truppe anlegen</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
