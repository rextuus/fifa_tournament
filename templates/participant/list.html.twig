{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Truppen{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">{{ icons.icon('users', 14) }} Kader</div>
            <h1 class="page-title">Truppen</h1>
        </div>
        <div class="page-actions">
            <a href="{{ path('player_create') }}" class="btn btn-secondary">{{ icons.icon('user', 18) }} Spieler</a>
            <a href="{{ path('participant_create') }}" class="btn btn-primary">{{ icons.icon('plus', 18) }} Neue Truppe</a>
        </div>
    </div>

    {% if participants|length > 0 %}
        <div class="tile-list two-col">
            {% for participant in participants %}
                <div class="tile is-link align-items-start">
                    {{ component('ProfileImageComponent', {profile: participant, width: 52}) }}
                    <div class="tile-body">
                        <a href="{{ path('participant_edit', { id: participant.id }) }}" class="tile-title stretched d-block">{{ participant.ident }}</a>
                        {% if participant.players|length > 0 %}
                            <div class="people">
                                {% for player in participant.players %}
                                    <span class="person">{{ component('ProfileImageComponent', {profile: player, width: 24}) }}{{ player.ident }}</span>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="tile-meta">Noch keine Spieler</div>
                        {% endif %}
                    </div>
                    <div class="tile-actions">
                        <a href="{{ path('spotify_search', { type: 'participant', id: participant.id }) }}" class="btn btn-secondary btn-icon btn-sm"
                           title="Torhymne" aria-label="Torhymne">{{ icons.icon('music', 17) }}</a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="panel empty">
            {{ icons.icon('users', 44) }}
            <p>Noch keine Truppen angelegt.</p>
            <a href="{{ path('participant_create') }}" class="btn btn-primary">{{ icons.icon('plus', 18) }} Truppe anlegen</a>
        </div>
    {% endif %}
{% endblock %}
