{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}{{ fixture.ident }}{% endblock %}

{% block body %}
    {% set tournament = fixture.round.tournament %}
    {% set backUrl = tournament.type.value == 'group_battle'
        ? path('tournament_detail_group_battle', {id: tournament.id, roundNr: fixture.round.nr})
        : path('tournament_detail', {id: tournament.id}) %}
    {% set isPlayed = fixture.played is not null %}
    {% set homeScore = isPlayed and fixture.firstLeg ? fixture.firstLeg.homeGoals : fixture.homeGoals %}
    {% set awayScore = isPlayed and fixture.firstLeg ? fixture.firstLeg.awayGoals : fixture.awayGoals %}

    {% if settings.isGoalGifEnabled %}
        <div id="goal-overlay"
             class="d-none align-items-center justify-content-center position-fixed top-0 start-0 w-100 h-100"
             title="Antippen zum Schließen">
            <img src="https://i.giphy.com/FoH28ucxZFJZu.webp" alt="Tor!" class="goal-gif">
        </div>
    {% endif %}

    <div class="medium">
        <a href="{{ backUrl }}" class="back-link">{{ icons.icon('back', 18) }} {{ tournament.ident }}</a>

        <section class="scoreboard">
            <div class="sb-label">
                {{ fixture.ident }} ·
                {% if isPlayed %}<span class="text-warning">Abgepfiffen</span>{% else %}<span style="color: var(--accent)">Live</span>{% endif %}
            </div>
            <div class="sb-grid">
                {% for side in [
                    {team: fixture.homeTeam, participant: fixture.homeParticipant},
                    {team: fixture.awayTeam, participant: fixture.awayParticipant},
                ] %}
                    {% if loop.index == 2 %}
                        <div class="sb-score-col">
                            <div class="sb-score">
                                <span data-score-home>{{ homeScore }}</span><span class="sep">:</span><span data-score-away>{{ awayScore }}</span>
                            </div>
                        </div>
                    {% endif %}
                    <div class="sb-side">
                        <div class="sb-crest">
                            {% if side.team %}
                                {{ component('ProfileImageComponent', {profile: side.team, width: 76}) }}
                            {% else %}
                                <span class="avatar is-crest"><img src="{{ asset('images/thumbnails/team_default.png') }}" alt=""></span>
                            {% endif %}
                            {% if side.participant %}
                                {{ component('ProfileImageComponent', {profile: side.participant, width: 34, class: 'owner'}) }}
                            {% endif %}
                        </div>
                        <div class="sb-team">{{ side.team.name ?? 'TBA' }}</div>
                        <div class="sb-owner">{{ side.participant.ident ?? '–' }}</div>
                    </div>
                {% endfor %}
            </div>

            {% if fixture.isTwoLeg %}
                {% set legs = [
                    {label: 'Hinspiel', leg: fixture.firstLeg},
                    {label: 'Rückspiel', leg: fixture.secondLeg},
                    {label: 'Entscheidung', leg: fixture.thirdLeg},
                ] %}
                {% set totalHome = 0 %}
                {% set totalAway = 0 %}
                <div class="legs">
                    {% for item in legs %}
                        {% if item.leg is not null %}
                            {% set totalHome = totalHome + item.leg.homeGoals %}
                            {% set totalAway = totalAway + item.leg.awayGoals %}
                            <div class="leg"><span>{{ item.label }}</span><strong>{{ item.leg.homeGoals }} : {{ item.leg.awayGoals }}</strong></div>
                        {% endif %}
                    {% endfor %}
                    <div class="leg is-total"><span>Gesamt</span><strong>{{ totalHome }} : {{ totalAway }}</strong></div>
                </div>
            {% endif %}
        </section>

        <div class="goal-pads">
            {% if fixture.homeParticipant %}
                {{ component('GoalComponent', {participant: fixture.homeParticipant, fixture: fixture, isHome: true}) }}
            {% endif %}
            {% if fixture.awayParticipant %}
                {{ component('GoalComponent', {participant: fixture.awayParticipant, fixture: fixture, isHome: false}) }}
            {% endif %}
        </div>

        <div class="action-dock">
            <a href="{{ backUrl }}" class="btn btn-secondary btn-lg" style="flex: 0 0 auto">{{ icons.icon('list', 20) }}</a>
            {% if not isPlayed %}
                <twig:AjaxFormModalLink
                        classes="btn btn-primary btn-lg"
                        submitText="Speichern"
                        modalTitle="Ergebnis eintragen"
                        formUrl="{{ url('match_edit_result',  {'id' : fixture.id}) }}">
                    {% import '_icons.html.twig' as icons %}
                    {{ icons.icon('check', 20) }} Abpfiff &amp; Ergebnis
                </twig:AjaxFormModalLink>
            {% else %}
                <a href="{{ backUrl }}" class="btn btn-primary btn-lg">Zur Übersicht</a>
            {% endif %}
        </div>
    </div>
{% endblock %}
