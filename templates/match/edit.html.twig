{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}{{ team.name }}{% endblock %}

{% block body %}
    <div class="narrow">
        <div class="profile-head">
            <twig:AjaxFormModalLink
                    modalTitle="Profilbild ändern"
                    classes="profile-image-link"
                    submitText="Speichern"
                    formUrl="{{ url('team_edit_profile_image',  {'id' : team.id}) }}">
                    {% import '_icons.html.twig' as icons %}
                {{ component('ProfileImageComponent', {profile: team, width: 128}) }}
                <span class="edit-badge">{{ icons.icon('edit', 16) }}</span>
            </twig:AjaxFormModalLink>
            <div>
                <div class="eyebrow">{{ icons.icon('shield', 14) }} Team</div>
                <h1>{{ team.name }}</h1>
            </div>
        </div>
    </div>
{% endblock %}
