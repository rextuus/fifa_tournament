{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}{{ tournament.ident }} verwalten{% endblock %}

{% block body %}
    {% set valid = tournament_is_valid(tournament) %}
    {% set isOpen = tournament.state.value == 'open' %}
    <div class="medium">
        <a href="{{ path('tournament_list') }}" class="back-link">{{ icons.icon('back', 18) }} Turniere</a>
        <div class="page-head">
            <div>
                <div class="eyebrow">{{ icons.icon('settings', 14) }} Verwalten · Gruppen-Battle</div>
                <h1 class="page-title">{{ tournament.ident }}</h1>
            </div>
            {% if not isOpen %}
                <div class="page-actions">
                    <a href="{{ path('tournament_detail', {id: tournament.id}) }}" class="btn btn-secondary">{{ icons.icon('trophy', 18) }} Zum Turnier</a>
                </div>
            {% endif %}
        </div>

        <div class="stack-lg">
            <section class="panel">
                {% if showAddPlayer %}
                    <div class="panel-head"><h2>Spieler nachmelden</h2></div>
                    <p class="text-muted small">Das Turnier läuft schon – neue Spieler werden in die bestehende Runde eingeplant.</p>
                    {{ form_start(addForm) }}
                    {{ form_row(addForm.player) }}
                    <button type="submit" class="btn btn-secondary btn-block">{{ icons.icon('plus', 18) }} Hinzufügen</button>
                    {{ form_end(addForm) }}
                {% else %}
                    <div class="panel-head"><h2>Spieler</h2></div>
                    <p class="text-muted small">Aus den Spielern werden automatisch alle Zweier-Truppen gebildet.</p>
                    {{ form_start(form) }}
                    {{ form_row(form.players) }}
                    <button type="submit" class="btn btn-secondary btn-block" {{ isOpen ? '' : 'disabled' }}>{{ icons.icon('check', 18) }} Speichern</button>
                    {{ form_end(form) }}
                {% endif %}
            </section>

            {% include 'tournament/_participant_status.html.twig' with {participants: tournament.battleRound.participants} %}
        </div>

        {% if isOpen %}
            <div class="action-dock">
                <form method="post" action="{{ path('tournament_calculate', {'id': tournament.id}) }}">
                    <button type="submit" class="btn btn-primary btn-lg btn-block" {{ valid ? '' : 'disabled' }}>
                        {{ icons.icon('play', 18) }} {{ valid ? 'Turnier starten' : 'Noch nicht startklar' }}
                    </button>
                </form>
            </div>
        {% endif %}
    </div>
{% endblock %}
