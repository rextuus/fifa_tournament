{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Turniere{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <div class="eyebrow">{{ icons.icon('trophy', 14) }} Übersicht</div>
            <h1 class="page-title">Turniere</h1>
        </div>
        <div class="page-actions">
            <a href="{{ path('tournament_create') }}" class="btn btn-primary">{{ icons.icon('plus', 18) }} Neues Turnier</a>
        </div>
    </div>

    {% set stateLabels = {open: 'Offen', active: 'Läuft', finished: 'Beendet'} %}
    {% set typeLabels = {classic: 'K.-o.-Turnier', group_battle: 'Gruppen-Battle'} %}

    {% if tournaments|length > 0 %}
        <div class="tile-list two-col">
            {% for tournament in tournaments %}
                {% set valid = tournament_is_valid(tournament) %}
                {% set state = tournament.state.value %}
                {% set people = tournament.type.value == 'group_battle' and tournament.battleRound ? tournament.battleRound.participants : tournament.participants %}
                <div class="tile is-link">
                    <span class="avatar md is-crest" style="color: var({{ state == 'finished' ? '--gold' : (state == 'active' ? '--accent' : '--info') }})">
                        {{ icons.icon(tournament.type.value == 'group_battle' ? 'users' : 'trophy', 26) }}
                    </span>
                    <div class="tile-body">
                        <a class="tile-title stretched d-block"
                           href="{{ state != 'open' ? path('tournament_detail', { id: tournament.id }) : path(tournament.editRoute, { id: tournament.id }) }}">
                            {{ tournament.ident }}
                        </a>
                        <div class="tile-meta">
                            <span class="chip is-{{ state }}">{{ stateLabels[state] ?? state }}</span>
                            <span>{{ typeLabels[tournament.type.value] ?? tournament.type.value }}</span>
                            <span>· {{ people|length }} {{ people|length == 1 ? 'Teilnehmer' : 'Teilnehmer' }}</span>
                            {% if state == 'open' and not valid %}
                                <span class="text-danger">· unvollständig</span>
                            {% endif %}
                        </div>
                    </div>
                    <div class="tile-actions">
                        <a href="{{ path(tournament.editRoute, { id: tournament.id }) }}" class="btn btn-secondary btn-icon btn-sm"
                           title="Verwalten" aria-label="Verwalten">{{ icons.icon('settings', 17) }}</a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="panel empty">
            {{ icons.icon('trophy', 44) }}
            <p>Noch keine Turniere. Zeit für das erste!</p>
            <a href="{{ path('tournament_create') }}" class="btn btn-primary">{{ icons.icon('plus', 18) }} Turnier anlegen</a>
        </div>
    {% endif %}
{% endblock %}
