{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Teamauswahl{% endblock %}

{% block body %}
    <a href="{{ path(tournament.editRoute, {id: tournament.id}) }}" class="back-link">{{ icons.icon('back', 18) }} {{ tournament.ident }}</a>
    <div class="page-head">
        <div class="d-flex align-items-center gap-3">
            {{ component('ProfileImageComponent', {profile: participant, width: 56}) }}
            <div>
                <div class="eyebrow">{{ icons.icon('shield', 14) }} Teamauswahl</div>
                <h1 class="page-title">{{ participant.ident }}</h1>
            </div>
        </div>
    </div>

    <div class="stack-lg">
        <section class="panel">
            <div class="progress-ring mb-3">
                <div class="bar"><span style="width: {{ allowed > 0 ? (listCount / allowed * 100)|round : 0 }}%"></span></div>
                <strong>{{ listCount }}/{{ allowed }}</strong>
            </div>
            {% if listCount >= allowed %}
                <p class="mb-0 text-muted">{{ icons.icon('check', 18, 'text-success') }} Alle Teams gewählt. Zum Tauschen erst ein Team entfernen.</p>
            {% else %}
                {{ form_start(form) }}
                {{ form_widget(form) }}
                <button type="submit" class="btn btn-primary btn-block mt-3">{{ icons.icon('plus', 18) }} Team hinzufügen</button>
                {{ form_end(form) }}
            {% endif %}
        </section>

        <section>
            <h2 class="section-title">Gewählte Teams</h2>
            {% if listCount > 0 %}
                {{ component('TeamListing', { participant: participant, tournament: tournament }) }}
            {% else %}
                <div class="panel empty"><p class="mb-0">Noch kein Team gewählt.</p></div>
            {% endif %}
        </section>
    </div>
{% endblock %}
