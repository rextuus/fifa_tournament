{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Neues Turnier{% endblock %}

{% block body %}
    <div class="narrow">
        <a href="{{ path('tournament_list') }}" class="back-link">{{ icons.icon('back', 18) }} Turniere</a>
        <div class="page-head">
            <div>
                <div class="eyebrow">{{ icons.icon('plus', 14) }} Anlegen</div>
                <h1 class="page-title">Neues Turnier</h1>
                <p class="page-sub">Name, Größe und Modus – Teilnehmer kommen im nächsten Schritt.</p>
            </div>
        </div>

        <div class="panel">
            {{ form_start(form) }}
            {{ form_row(form.ident) }}
            {{ form_row(form.level) }}
            {{ form_row(form.type) }}
            <button type="submit" class="btn btn-primary btn-lg btn-block mt-2">{{ icons.icon('check', 20) }} Turnier anlegen</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
