{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}{{ tournament.ident }}{% endblock %}

{% block body %}
    {% set roundNr = next - 1 %}
    {% set nextFixture = null %}
    {% for fixture in orderedFixtures %}
        {% if nextFixture is null and fixture.played is null %}
            {% set nextFixture = fixture %}
        {% endif %}
    {% endfor %}

    <a href="{{ path('tournament_list') }}" class="back-link">{{ icons.icon('back', 18) }} Turniere</a>
    <div class="page-head">
        <div>
            <div class="eyebrow">{{ icons.icon('users', 14) }} Gruppen-Battle</div>
            <h1 class="page-title">{{ tournament.ident }}</h1>
            <p class="page-sub">{{ playedCount }} von {{ orderedFixtures|length }} Spielen gespielt</p>
        </div>
        <div class="page-actions">
            {% if tournament.rounds|length > 1 %}
                <nav class="segmented">
                    <a href="{{ path('tournament_detail_group_battle', {id: tournament.id, roundNr: 1}) }}"
                       class="{{ roundNr == 1 ? 'is-active' }}">Gruppenphase</a>
                    <a href="{{ path('tournament_detail_group_battle', {id: tournament.id, roundNr: roundNr == 1 ? 2 : roundNr}) }}"
                       class="{{ roundNr > 1 ? 'is-active' }}">Finalrunde</a>
                </nav>
            {% endif %}
            <a href="{{ path(tournament.editRoute, { id: tournament.id }) }}" class="btn btn-secondary btn-icon"
               title="Verwalten" aria-label="Verwalten">{{ icons.icon('settings', 18) }}</a>
        </div>
    </div>

    <div class="stack-lg">
        {% if nextFixture %}
            <section>
                <h2 class="section-title">Nächstes Spiel</h2>
                <div class="fixture-list">
                    {{ component('FixtureComponent', {fixture: nextFixture, highlight: true}) }}
                </div>
            </section>
        {% endif %}

        <section class="award-grid">
            <div class="award">
                <div class="award-label">{{ icons.icon('crown', 14) }} Schützenkönig</div>
                <div class="award-people">
                    {{ component('ProfileImageComponent', {profile: goalLeader.player, width: 52}) }}
                    <img src="{{ asset('images/thumbnails/messi.gif') }}" alt="" class="award-gif">
                </div>
                <div>
                    <div class="award-name">{{ goalLeader.player.ident }}</div>
                    <div class="award-value">{{ goalLeader.personal_goals }}<small>Tore</small></div>
                </div>
            </div>
            <div class="award is-bad">
                <div class="award-label">{{ icons.icon('shield', 14) }} Kackbude</div>
                <div class="award-people">
                    {{ component('ProfileImageComponent', {profile: shootingGallery.player, width: 52}) }}
                    <img src="{{ asset('images/thumbnails/nelson.gif') }}" alt="" class="award-gif">
                </div>
                <div>
                    <div class="award-name">{{ shootingGallery.player.ident }}</div>
                    <div class="award-value">{{ shootingGallery.team_goals }}<small>kassiert</small></div>
                </div>
            </div>
        </section>

        <section class="panel">
            <h2 class="section-title">Tabelle <span class="count">{{ rankedPlayers|length }} Spieler</span></h2>
            <div class="table-scroll">
                <table class="standings">
                    <thead>
                    <tr>
                        <th class="col-rank">#</th>
                        <th class="col-player">Spieler</th>
                        <th title="Punkte">Pkt</th>
                        <th title="Spiele">Sp</th>
                        <th title="Siege">S</th>
                        <th title="Unentschieden">U</th>
                        <th title="Niederlagen">N</th>
                        <th title="Eigene Tore">T</th>
                        <th title="Tore des Teams">TT</th>
                        <th title="Gegentore">GT</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for rank, player in rankedPlayers %}
                        <tr class="top-{{ rank + 1 }}">
                            <td class="col-rank">{{ rank + 1 }}</td>
                            <td class="col-player">
                                <div>
                                    {{ component('ProfileImageComponent', {profile: player.player, width: 30}) }}
                                    <span>{{ player.player.ident }}</span>
                                </div>
                            </td>
                            <td class="col-points">{{ player.points }}</td>
                            <td class="muted">{{ player.matches }}</td>
                            <td>{{ player.wins }}</td>
                            <td>{{ player.draws }}</td>
                            <td>{{ player.looses }}</td>
                            <td>{{ player.personal_goals }}</td>
                            <td class="muted">{{ player.team_goals }}</td>
                            <td class="muted">{{ player.against_goals }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

        {% set openFixtures = orderedFixtures|filter(f => f.played is null and (nextFixture is null or f.id != nextFixture.id)) %}
        {% set playedFixtures = orderedFixtures|filter(f => f.played is not null) %}
        {% if openFixtures|length > 0 %}
            <section>
                <h2 class="section-title">Danach <span class="count">{{ openFixtures|length }} offen</span></h2>
                <div class="fixture-list">
                    {% for fixture in openFixtures %}
                        {{ component('FixtureComponent', {fixture: fixture}) }}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% if playedFixtures|length > 0 %}
            <details class="fold">
                <summary class="section-title">
                    <span>Gespielt</span>
                    <span class="count">{{ playedFixtures|length }} Spiele</span>
                </summary>
                <div class="fixture-list">
                    {% for fixture in playedFixtures|reverse %}
                        {{ component('FixtureComponent', {fixture: fixture}) }}
                    {% endfor %}
                </div>
            </details>
        {% endif %}
    </div>
{% endblock %}
