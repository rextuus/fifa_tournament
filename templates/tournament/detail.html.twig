{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}{{ tournament.ident }}{% endblock %}

{% block body %}
    <a href="{{ path('tournament_list') }}" class="back-link">{{ icons.icon('back', 18) }} Turniere</a>
    <div class="page-head">
        <div>
            <div class="eyebrow">{{ icons.icon('trophy', 14) }} K.-o.-Baum</div>
            <h1 class="page-title">{{ tournament.ident }}</h1>
        </div>
        <div class="page-actions">
            <a href="{{ path(tournament.editRoute, { id: tournament.id }) }}" class="btn btn-secondary">{{ icons.icon('settings', 18) }} Verwalten</a>
        </div>
    </div>

    <div class="bracket">
        {% for round in tournament.rounds %}
            {% set col = loop.index0 %}
            {% set fixtures = [] %}
            {% for row in matrix %}
                {% if row[col] is defined and row[col] != 'X' %}
                    {% set fixtures = fixtures|merge([row[col]]) %}
                {% endif %}
            {% endfor %}
            <section class="bracket-round">
                <div class="bracket-title">
                    <span>{{ round.roundType.getRoundDescription }}</span>
                    <span>{{ loop.index }}/{{ loop.length }}</span>
                </div>
                <div class="bracket-matches">
                    {% for fixture in fixtures %}
                        {{ component('FixtureComponent', {fixture: fixture}) }}
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    </div>
{% endblock %}
