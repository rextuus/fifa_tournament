{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}{{ tournament.ident }} verwalten{% endblock %}

{% block body %}
    {% set valid = tournament_is_valid(tournament) %}
    <div class="medium">
        <a href="{{ path('tournament_list') }}" class="back-link">{{ icons.icon('back', 18) }} Turniere</a>
        <div class="page-head">
            <div>
                <div class="eyebrow">{{ icons.icon('settings', 14) }} Verwalten · K.-o.-Turnier</div>
                <h1 class="page-title">{{ tournament.ident }}</h1>
            </div>
            {% if tournament.state.value != 'open' %}
                <div class="page-actions">
                    <a href="{{ path('tournament_detail', {id: tournament.id}) }}" class="btn btn-secondary">{{ icons.icon('trophy', 18) }} Zum Turnier</a>
                </div>
            {% endif %}
        </div>

        <div class="stack-lg">
            <section class="panel">
                <div class="panel-head"><h2>Einstellungen</h2></div>
                {{ form_start(form) }}
                {{ form_row(form.level) }}
                {{ form_row(form.participants) }}
                <button type="submit" class="btn btn-secondary btn-block">{{ icons.icon('check', 18) }} Speichern</button>
                {{ form_end(form) }}
            </section>

            {% include 'tournament/_participant_status.html.twig' with {participants: tournament.participants} %}
        </div>

        {% if tournament.state.value == 'open' %}
            <div class="action-dock">
                <form method="post" action="{{ path('tournament_calculate', {'id': tournament.id}) }}">
                    <button type="submit" class="btn btn-primary btn-lg btn-block" {{ valid ? '' : 'disabled' }}>
                        {{ icons.icon('play', 18) }} {{ valid ? 'Turnier starten' : 'Noch nicht startklar' }}
                    </button>
                </form>
            </div>
        {% endif %}
    </div>
{% endblock %}
