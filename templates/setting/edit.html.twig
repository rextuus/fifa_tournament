{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Einstellungen{% endblock %}

{% block body %}
    <div class="narrow">
        <div class="page-head">
            <div>
                <div class="eyebrow">{{ icons.icon('settings', 14) }} Setup</div>
                <h1 class="page-title">Einstellungen</h1>
            </div>
        </div>

        <div class="stack-lg">
            <div class="panel">
                {{ form_start(form) }}
                {{ form_row(form.maximumSongDuration) }}
                {{ form_row(form.songPlayTimeLimit) }}
                {{ form_row(form.goalMusicEnabled) }}
                {{ form_row(form.goalGifEnabled) }}
                {{ form_widget(form.save, {attr: {class: 'btn btn-primary btn-lg btn-block mt-2'}}) }}
                {{ form_end(form) }}
            </div>

            <div class="panel">
                <div class="panel-head">
                    <h2>Queue</h2>
                    {% if queueIsRunning %}
                        <span class="chip is-active">Läuft</span>
                    {% else %}
                        <span class="chip">Idle</span>
                    {% endif %}
                </div>
                <p class="text-muted small">Prüft die Hintergrund-Queue (z. B. Torhymnen-Stopp) und stößt sie bei Bedarf an.</p>
                <a href="{{ path('check_queue') }}" class="btn btn-secondary btn-block">{{ icons.icon('bolt', 18) }} Queue prüfen</a>
            </div>
        </div>
    </div>
{% endblock %}
