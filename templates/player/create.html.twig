{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Spieler{% endblock %}

{% block body %}
    <a href="{{ path('participant_manage') }}" class="back-link">{{ icons.icon('back', 18) }} Truppen</a>
    <div class="page-head">
        <div>
            <div class="eyebrow">{{ icons.icon('user', 14) }} Kader</div>
            <h1 class="page-title">Spieler</h1>
        </div>
    </div>

    <div class="stack-lg">
        <form action="{{ path('player_create') }}" method="post" class="panel">
            <label for="playerIdent" class="form-label">Neuer Spieler</label>
            <div class="d-flex gap-2">
                <input type="text" class="form-control" id="playerIdent" name="playerIdent" placeholder="Name" required>
                <button type="submit" class="btn btn-primary" style="flex-shrink: 0">{{ icons.icon('plus', 18) }} Anlegen</button>
            </div>
        </form>

        <section>
            <h2 class="section-title">Alle Spieler <span class="count">{{ players|length }}</span></h2>
            {% if players|length > 0 %}
                <div class="tile-list two-col">
                    {% for player in players %}
                        <div class="tile is-link">
                            {{ component('ProfileImageComponent', {profile: player, width: 44}) }}
                            <div class="tile-body">
                                <a href="{{ path('player_edit', { id: player.id }) }}" class="tile-title stretched d-block">{{ player.ident }}</a>
                            </div>
                            <div class="tile-actions">
                                <a href="{{ path('spotify_search', { type: 'player', id: player.id }) }}" class="btn btn-secondary btn-icon btn-sm"
                                   title="Torhymne" aria-label="Torhymne">{{ icons.icon('music', 17) }}</a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="panel empty"><p class="mb-0">Noch keine Spieler angelegt.</p></div>
            {% endif %}
        </section>
    </div>
{% endblock %}
