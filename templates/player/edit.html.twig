{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}{{ player.ident }}{% endblock %}

{% block body %}
    <div class="narrow">
        <a href="{{ path('player_create') }}" class="back-link">{{ icons.icon('back', 18) }} Spieler</a>

        <div class="stack-lg">
            <div class="profile-head">
                <twig:AjaxFormModalLink
                        modalTitle="Profilbild ändern"
                        classes="profile-image-link"
                        submitText="Speichern"
                        formUrl="{{ url('player_edit_profile_image',  {'id' : player.id}) }}">
                    {% import '_icons.html.twig' as icons %}
                    {{ component('ProfileImageComponent', {profile: player, width: 128}) }}
                    <span class="edit-badge">{{ icons.icon('edit', 16) }}</span>
                </twig:AjaxFormModalLink>
                <div>
                    <div class="eyebrow">{{ icons.icon('user', 14) }} Spieler</div>
                    <h1>{{ player.ident }}</h1>
                </div>
                <a href="{{ path('spotify_search', { type: 'player', id: player.id }) }}" class="btn btn-secondary btn-sm">{{ icons.icon('music', 16) }} Torhymne</a>
            </div>

            <div class="qr-box">
                <img src="{{ qrCodeDataUri }}" alt="QR-Code">
                <p><strong>Bild per Handy</strong>QR-Code scannen und direkt ein Foto als Profilbild hochladen.</p>
            </div>

            <div class="panel">
                {{ form_start(form) }}
                {{ form_row(form.ident) }}
                <button type="submit" class="btn btn-primary btn-lg btn-block mt-2">{{ icons.icon('check', 20) }} Speichern</button>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
