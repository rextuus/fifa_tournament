{% import '_icons.html.twig' as icons %}
{% set route = app.current_route ?? '' %}
{% set nav = [
    {label: 'Home', icon: 'home', route: 'dashboard', active: route == 'dashboard'},
    {label: 'Turniere', icon: 'trophy', route: 'tournament_list', active: route starts with 'tournament' or route starts with 'match'},
    {label: 'Truppen', icon: 'users', route: 'participant_manage', active: route starts with 'participant' or route starts with 'player'},
    {label: 'Musik', icon: 'music', route: 'spotify_info', active: route starts with 'spotify' or route == 'app_select_song'},
    {label: 'Setup', icon: 'settings', route: 'setting_edit', active: route starts with 'setting' or route == 'check_queue'},
] %}

<header class="topbar">
    <div class="topbar-inner">
        <a class="brand" href="{{ path('dashboard') }}">
            <span class="brand-mark">{{ icons.icon('trophy', 18) }}</span>
            <span class="brand-text">EAT<span class="brand-sub">Turniermanager</span></span>
        </a>

        {% if app.user %}
            <nav class="topnav" aria-label="Hauptnavigation">
                {% for item in nav %}
                    <a href="{{ path(item.route) }}" class="topnav-link {{ item.active ? 'is-active' }}">
                        {{ icons.icon(item.icon, 18) }}<span>{{ item.label }}</span>
                    </a>
                {% endfor %}
            </nav>
            <a href="{{ path('app_logout') }}" class="icon-btn" title="Logout" aria-label="Logout">
                {{ icons.icon('logout', 20) }}
            </a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn btn-sm btn-outline-light ms-auto">Login</a>
        {% endif %}
    </div>
</header>

{% if app.user %}
    <nav class="tabbar" aria-label="Hauptnavigation">
        {% for item in nav %}
            <a href="{{ path(item.route) }}" class="tabbar-link {{ item.active ? 'is-active' }}">
                <span class="tabbar-icon">{{ icons.icon(item.icon, 22) }}</span>
                <span class="tabbar-label">{{ item.label }}</span>
            </a>
        {% endfor %}
    </nav>
{% endif %}
