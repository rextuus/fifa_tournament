{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Login{% endblock %}
{% block body_class %}auth-page{% endblock %}
{% block header %}{% endblock %}

{% block body %}
    <div class="auth-card">
        <div class="auth-logo">{{ icons.icon('trophy', 32) }}</div>
        <h1>Anpfiff</h1>
        <p class="auth-sub">Melde dich an, um Turniere zu verwalten.</p>

        <div class="panel">
            <form method="post">
                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                {% if app.user %}
                    <div class="alert alert-info">
                        Angemeldet als <strong>{{ app.user.userIdentifier }}</strong> ·
                        <a href="{{ path('app_logout') }}" class="alert-link">Logout</a>
                    </div>
                {% endif %}

                <div class="mb-3">
                    <label for="username" class="form-label">E-Mail</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username"
                           class="form-control" autocomplete="email" required autofocus>
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label">Passwort</label>
                    <input type="password" name="_password" id="password"
                           class="form-control" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-primary btn-lg btn-block" type="submit">
                    {{ icons.icon('login', 20) }} Einloggen
                </button>
            </form>
        </div>

        {% if registration_enabled %}
            <p class="text-center text-muted mt-3">
                Noch kein Konto? <a href="{{ path('app_register') }}">Registrieren</a>
            </p>
        {% endif %}
    </div>
{% endblock %}
