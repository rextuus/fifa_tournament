{% extends 'base.html.twig' %}
{% import '_icons.html.twig' as icons %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    <section class="hero">
        <div class="eyebrow">{{ icons.icon('bolt', 14) }} Anpfiff</div>
        <h1>Wer holt sich<br><em>den Pott?</em></h1>
        <p>Turniere anlegen, Teams losen, Tore feiern – mit Torhymne und allem Drum und Dran.</p>
        <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('tournament_create') }}" class="btn btn-primary btn-lg">{{ icons.icon('plus', 20) }} Neues Turnier</a>
            <a href="{{ path('tournament_list') }}" class="btn btn-secondary btn-lg">Alle Turniere</a>
        </div>
        <span class="hero-ball">{{ icons.icon('ball', 220) }}</span>
    </section>

    <div class="action-grid">
        <a href="{{ path('tournament_list') }}" class="action-card">
            <span class="action-icon">{{ icons.icon('trophy', 22) }}</span>
            <div>
                <h3>Turniere</h3>
                <p>Anlegen, verwalten, spielen</p>
            </div>
        </a>
        <a href="{{ path('participant_manage') }}" class="action-card tone-info">
            <span class="action-icon">{{ icons.icon('users', 22) }}</span>
            <div>
                <h3>Truppen</h3>
                <p>Teams &amp; Spieler pflegen</p>
            </div>
        </a>
        <a href="{{ path('spotify_info') }}" class="action-card tone-gold">
            <span class="action-icon">{{ icons.icon('music', 22) }}</span>
            <div>
                <h3>Spotify</h3>
                <p>Torhymnen verbinden</p>
            </div>
        </a>
        <a href="{{ path('setting_edit') }}" class="action-card tone-danger">
            <span class="action-icon">{{ icons.icon('settings', 22) }}</span>
            <div>
                <h3>Setup</h3>
                <p>Allgemeine Einstellungen</p>
            </div>
        </a>
    </div>
{% endblock %}
