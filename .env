# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# KEINE ECHTEN SECRETS IN DIESE DATEI (sie ist committet). Lokale Werte gehören in .env.local,
# Produktionswerte in Komodo (siehe .env.prod.dist und docs/deployment.md).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

# Öffentliche Adresse (für URLs außerhalb eines Requests, z. B. in Befehlen)
DEFAULT_URI=http://localhost:8000

# Von diesen Adressen werden X-Forwarded-* übernommen (in Produktion: der Caddy im Stack).
TRUSTED_PROXIES=127.0.0.1

###> doctrine/doctrine-bundle ###
# Lokal: SQLite. Produktion: MySQL 8.4 (compose.prod.yaml setzt DATABASE_URL selbst).
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

# Originalbilder (Uploads, Team-Wappen). Absoluter Pfad; in Produktion /srv/eat/images.
IMAGE_DIR=%kernel.project_dir%/data/images

# imgproxy (Bildgrößen). Leer = aus: Bilder werden im Original ausgeliefert (lokale Entwicklung).
IMGPROXY_KEY=
IMGPROXY_SALT=

# Offene Registrierung unter /register (1 = an). In Produktion aus: Benutzer per app:create-default-user anlegen.
REGISTRATION_ENABLED=1

# Spotify (Werte in .env.local bzw. Komodo)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/spotify/callback
# Länge der Tor-Hymne in Sekunden
FORCED_RUNNING_TIME=30

###> sentry/sentry-symfony ###
# Leer = Sentry aus
SENTRY_DSN=
###< sentry/sentry-symfony ###
